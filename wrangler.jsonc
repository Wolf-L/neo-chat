{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neo-chat",
  "main": ".open-next/worker.js",
  "minify": true,
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  // chat.qqedu.ccwu.cc: Workers Custom Domain on the Cloudflare zone.
  // chat.metyou.top: Aliyun DNS CNAME to an optimized SaaS hostname, served
  // via a Cloudflare for SaaS custom hostname on the qqedu.ccwu.cc zone.
  "routes": [
    { "pattern": "chat.qqedu.ccwu.cc", "custom_domain": true },
    {
      "pattern": "chat.metyou.top/*",
      "zone_id": "1b6c1d77bee567a671c463b5470ea7d2",
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.1,
    },
  },
  "vars": {
    // Keep only non-sensitive deployment defaults here. Set per-deployment
    // secrets and user-specific defaults in the Cloudflare dashboard.
    "DEPLOYMENT_MODE": "hosted",
  },
}
